# Server port for the Express API
PORT=5000

# React app URL allowed by CORS
CLIENT_URL=http://localhost:5173

# Session secret used by express-session
# Change this to any long random string on your machine
SESSION_SECRET=vendorbridge-secret

# Local PostgreSQL connection settings
# Update these based on your pgAdmin/PostgreSQL setup
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendorbridge
DB_USER=postgres
DB_PASSWORD=postgres
